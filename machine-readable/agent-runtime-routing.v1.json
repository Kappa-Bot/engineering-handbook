        "selection": "prefer_cheaper_eval_passing_configuration"
      },
      {
        "case": "multi_component_integration_migration_difficult_debugging",
        "model": "gpt-6.1-sol",
        "effort_options": [
          "medium",
          "high"
        ]
      },
      {
        "case": "high_uncertainty_high_impact_architecture_security_data_authorization",
        "model": "gpt-6-astra",
        "effort": "high"
      },
      {
        "case": "exceptional_long_horizon_or_adversarial_reasoning",
