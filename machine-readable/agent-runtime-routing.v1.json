      {
        "case": "frozen_contract_strong_verification",
        "model": "gpt-6-luna",
        "effort": "medium"
      },
      {
        "case": "bounded_tricky_strong_verification",
        "model_options": [
          "gpt-6-luna/high",
          "gpt-6.1-sol/medium"
