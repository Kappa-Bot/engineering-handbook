{"schema":"handbook-compiled/v1","units":[{"activate_all":[],"activate_when":["boundary:external","operation:integration"],"covers":["compatibility"],"estimated_tokens":29,"excludes":[],"id":"api-contract-single-source","phase":["implementation","planning"],"priority":78,"requires":[],"source":"pat-api-contract-evolution","sources":["pat-api-contract-evolution"],"text":"Choose one authoritative API contract model and avoid independently maintained canonical contracts that can drift.","type":"constraint"},{"activate_all":[],"activate_when":["operation:migration","state:migration"],"covers":["data-loss"],"estimated_tokens":24,"excludes":[],"force":"must","id":"architecture-migrations-are-production-state","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"std-architecture-data-integrity-baseline","sources":["std-architecture-data-integrity-baseline"],"text":"Treat migrations as executable changes to production state rather than ordinary source edits.","type":"constraint"},{"activate_all":[],"activate_when":["operation:authorization","risk:authorization","risk:privilege","risk:tenant-isolation"],"covers":["authorization","privilege","tenant-isolation"],"estimated_tokens":42,"excludes":[],"id":"authz-pattern-request-resource-boundary","phase":["implementation","planning"],"priority":88,"requires":[],"source":"pat-authorization-privileged-boundaries","sources":["pat-authorization-privileged-boundaries"],"text":"Resolve the authoritative actor/relationship, authorize the action plus resource at the protected boundary, then perform the operation and return only necessary data.","type":"pattern"},{"activate_all":[],"activate_when":["capability:pwa","surface:frontend"],"covers":["accessibility"],"estimated_tokens":41,"excludes":[],"id":"mobile-focused-content-visible","phase":["implementation","verification"],"priority":82,"requires":[],"source":"pat-mobile-responsive-interaction","sources":["pat-mobile-responsive-interaction"],"text":"Keep focused editable content and required actions reachable and visible when virtual keyboards, fixed navigation, sheets, or safe areas reduce the usable viewport.","type":"constraint"},{"activate_all":[],"activate_when":["delivery:production","risk:credential"],"covers":["credential"],"estimated_tokens":39,"excludes":[],"force":"must-not","id":"observability-no-sensitive-telemetry","phase":["implementation","verification"],"priority":94,"requires":[],"source":"pat-observability-signals","sources":["pat-observability-signals"],"text":"Do not log secrets, authorization tokens, or unnecessary sensitive payloads; treat telemetry volume, retention, PII, and cardinality as production concerns.","type":"constraint"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment","operation:migration"],"covers":["availability","data-loss"],"estimated_tokens":36,"excludes":[],"force":"should","id":"operability-production-recovery","phase":["implementation","planning"],"priority":82,"requires":[],"source":"std-production-operability-baseline","sources":["std-production-operability-baseline"],"text":"What practical retry, rollback, forward-fix, repair, restore, degradation, or operator recovery path exists for each material production risk?","type":"decision-question"},{"activate_all":[],"activate_when":["risk:performance"],"covers":["performance"],"estimated_tokens":42,"excludes":[],"id":"performance-no-universal-budget","phase":["implementation","planning"],"priority":72,"requires":[],"source":"pat-performance-budgeting","sources":["pat-performance-budgeting"],"text":"Do not copy one global performance threshold across unrelated products; define numeric budgets only when repeated regression risk and a stable measurement justify them.","type":"constraint"},{"activate_all":["capability:pwa","operation:mutation"],"activate_when":[],"covers":["availability","data-loss"],"estimated_tokens":45,"excludes":[],"force":"must","id":"pwa-connectivity-contract","phas