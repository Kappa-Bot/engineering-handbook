raint"},{"activate_all":[],"activate_when":["risk:accessibility","surface:frontend"],"covers":["accessibility"],"estimated_tokens":42,"excludes":[],"force":"must","id":"ui-accessibility-baseline","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"std-ui-ux-quality-baseline","sources":["std-ui-ux-quality-baseline"],"text":"Target applicable user-facing web content to WCAG 2.2 AA and preserve keyboard operation, visible focus, meaningful naming/order, reflow, and non-color-only semantics.","type":"constraint"},{"activate_all":[],"activate_when":["surface:frontend"],"covers":["accessibility"],"estimated_tokens":32,"excludes":[],"force":"must","id":"ui-responsive-integrity","phase":["implementation","planning","verification"],"priority":75,"requires":[],"source":"std-ui-ux-quality-baseline","sources":["std-ui-ux-quality-baseline"],"text":"Preserve required information and actions at narrow widths and do not hide real layout defects with global overflow clipping.","type":"constraint"},{"activate_all":[],"activate_when":["archetype:ui-flow-change","archetype:visual-regression-fix","surface:frontend"],"covers":["compatibility"],"estimated_tokens":36,"excludes":[],"force":"must","id":"visual-evidence-assert-state-first","phase":["implementation","verification"],"priority":90,"requires":[],"source":"pat-visual-evidence-integrity","sources":["pat-visual-evidence-integrity"],"text":"Assert the intended semantic UI state before capturing visual evidence; filenames or action attempts are not proof that the state was reached.","type":"constraint"}]}
