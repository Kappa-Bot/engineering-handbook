{"schema":"handbook-compiled/v1","units":[{"activate_all":[],"activate_when":["boundary:external","operation:integration"],"covers":["compatibility"],"estimated_tokens":45,"excludes":[],"id":"api-contract-drift-verification","phase":["verification"],"priority":90,"requires":[],"source":"pat-api-contract-evolution","sources":["pat-api-contract-evolution"],"text":"Where interface breakage is harmful, verify implementation compatibility using schema, contract, generated-client, or consumer integration evidence; syntax alone is insufficient.","type":"verification"},{"activate_all":[],"activate_when":["operation:migration","state:migration"],"covers":["data-loss"],"estimated_tokens":22,"excludes":[],"force":"must","id":"architecture-migration-verification","phase":["verification"],"priority":100,"requires":[],"source":"std-architecture-data-integrity-baseline","sources":["std-architecture-data-integrity-baseline"],"text":"Verify the migration or data transformation path when the change alters durable state.","type":"verification"},{"activate_all":[],"activate_when":["operation:migration","state:migration"],"covers":["data-loss"],"estimated_tokens":24,"excludes":[],"force":"must","id":"architecture-migrations-are-production-state","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"std-architecture-data-integrity-baseline","sources":["std-architecture-data-integrity-baseline"],"text":"Treat migrations as executable changes to production state rather than ordinary source edits.","type":"constraint"},{"activate_all":[],"activate_when":["risk:authorization","risk:privilege","risk:tenant-isolation"],"covers":["authorization","privilege","tenant-isolation"],"estimated_tokens":33,"excludes":[],"id":"authz-pattern-regression-matrix","phase":["verification"],"priority":92,"requires":[],"source":"pat-authorization-privileged-boundaries","sources":["pat-authorization-privileged-boundaries"],"text":"Exercise allowed and denied actor/resource combinations, including other-user, other-tenant, and admin-only paths where applicable.","type":"verification"},{"activate_all":[],"activate_when":["capability:pwa","surface:frontend"],"covers":["accessibility"],"estimated_tokens":41,"excludes":[],"id":"mobile-focused-content-visible","phase":["implementation","verification"],"priority":82,"requires":[],"source":"pat-mobile-responsive-interaction","sources":["pat-mobile-responsive-interaction"],"text":"Keep focused editable content and required actions reachable and visible when virtual keyboards, fixed navigation, sheets, or safe areas reduce the usable viewport.","type":"constraint"},{"activate_all":[],"activate_when":["capability:pwa","surface:frontend"],"covers":["accessibility","compatibility"],"estimated_tokens":52,"excludes":[],"id":"mobile-native-physical-verification","phase":["verification"],"priority":88,"requires":[],"source":"pat-mobile-responsive-interaction","sources":["pat-mobile-responsive-interaction"],"text":"Use representative real-device verification when acceptance depends on installed-PWA, virtual-keyboard feel/layout, safe-area geometry, or camera ergonomics; otherwise record that physical gate as not run.","type":"verification"},{"activate_all":[],"activate_when":["delivery:production","risk:credential"],"covers":["credential"],"estimated_tokens":39,"excludes":[],"force":"must-not","id":"observability-no-sensitive-telemetry","phase":["implementation","verification"],"priority":94,"requires":[],"source":"pat-observability-signals","sources":["pat-observability-signals"],"text":"Do not log secrets, authorization tokens, or unnecessary sensitive payloads; treat telemetry volume, retention, PII, and cardinality as production concerns.","type":"constraint"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment"],"covers":["availability"],"estimated_tokens":22,"excludes":[],"force":"should","id":"operability-runtime-not-build-truth","phase":["planning","verification"],"priority":95,"requires":[],"source":"std-production-operability-baseline","sources":["std-production-operability-baseline"],"text":"Do not treat a successful build or CI run as proof that the deployed product is healthy.","type":"constraint"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment"],"covers":["availability"],"estimated_tokens":35,"excludes":[],"force":"should","id":"operability-runtime-verification","phase":["verification"],"priority":90,"requires":[],"source":"std-production-operability-baseline","sources":["std-production-operability-baseline"],"text":"Verify environment-appropriate runtime identity, reachability or health, and material failure visibility for production-relevant changes.","type":"verification"},{"activate_all":[],"activate_when":["risk:performance"],"covers":["performance"],"estimated_tokens":45,"excludes":[],"id":"performance-measure-before-optimization","phase":["verification"],"priority":94,"requires":[],"source":"pat-performance-budgeting","sources":["pat-performance-budgeting"],"text":"Capture a reproducible baseline and compare the same journey, environment, data size, device/network class, and metric before claiming a performance improvement or regression gate.","type":"verification"},{"activate_all":[],"activate_when":["archetype:pwa-capability-change","capability:pwa"],"covers":["accessibility","compatibility"],"estimated_tokens":49,"excludes":[],"force":"must","id":"pwa-native-evidence-boundary","phase":["verification"],"priority":95,"requires":[],"source":"std-web-pwa-baseline","sources":["std-web-pwa-baseline"],"text":"Do not infer native launcher, installed-shell, virtual-keyboard, camera, or OS behavior from browser automation; verify representative devices when release-critical or record the gate as not run.","type":"verification"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment"],"covers":["availability","compatibility"],"estimated_tokens":42,"excludes":[],"id":"release-identity-target-verification","phase":["verification"],"priority":100,"requires":[],"source":"pat-release-provenance-environment-gates","sources":["pat-release-provenance-environment-gates"],"text":"Verify the expected immutable source or build identity, target environment, deployment result, and applicable post-deploy health or smoke evidence as distinct states.","type":"verification"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment"],"covers":["data-loss"],"estimated_tokens":23,"excludes":[],"force":"must-not","id":"release-no-production-seed-reset","phase":["implementation","verification"],"priority":100,"requires":[],"source":"pat-release-provenance-environment-gates","sources":["pat-release-provenance-environment-gates"],"text":"Do not run local or demo reset/seed behavior against Production as ordinary release setup.","type":"constraint"},{"activate_all":[],"activate_when":["operation:authorization","risk:authorization","risk:privilege","risk:tenant-isolation"],"covers":["authorization","privilege","tenant-isolation"],"estimated_tokens":33,"excludes":[],"force":"should","id":"security-authorization-negative-cases","phase":["verification"],"priority":100,"requires":[],"source":"std-security-identity-baseline","sources":["std-security-identity-baseline"],"text":"Verify denied paths and cross-role, cross-tenant, or object-access cases that are relevant to the changed authorization boundary.","type":"verification"},{"activate_all":[],"activate_when":["risk:credential"],"covers":["credential"],"estimated_tokens":31,"excludes":[],"force":"should","id":"security-credential-verification","phase":["verification"],"priority":95,"requires":[],"source":"std-security-identity-baseline","sources":["std-security-identity-baseline"],"text":"Verify the credential lifecycle and that privileged or raw credentials are not exposed through client code or ordinary logs.","type":"verification"},{"activate_all":[],"activate_when":["operation:deployment","surface:ci"],"covers":["compatibility"],"estimated_tokens":39,"excludes":[],"force":"should","id":"supply-chain-actions-pin","phase":["implementation","planning","verification"],"priority":70,"requires":[],"source":"std-dependency-supply-chain-baseline","sources":["std-dependency-supply-chain-baseline"],"text":"Prefer full-length immutable commit SHAs for third-party GitHub Actions, especially when workflows have secrets, write permissions, or deployment authority.","type":"constraint"},{"activate_all":[],"activate_when":["risk:credential","surface:ci"],"covers":["credential"],"estimated_tokens":28,"excludes":[],"force":"must-not","id":"supply-chain-untrusted-no-production-secrets","phase":["implementation","verification"],"priority":100,"requires":[],"source":"std-dependency-supply-chain-baseline","sources":["std-dependency-supply-chain-baseline"],"text":"Do not give untrusted pull-request or fork execution production secrets or privileged deployment credentials.","type":"constraint"},{"activate_all":[],"activate_when":["operation:deployment","surface:ci"],"covers":["availability"],"estimated_tokens":23,"excludes":[],"force":"must","id":"testing-ci-evidence-scope","phase":["verification"],"priority":88,"requires":[],"source":"std-testing-release-quality-baseline","sources":["std-testing-release-quality-baseline"],"text":"A green CI result proves only the configured jobs that actually ran for that commit or run.","type":"constraint"},{"activate_all":[],"activate_when":["operation:migration","state:migration"],"covers":["compatibility","data-loss"],"estimated_tokens":34,"excludes":[],"force":"should","id":"testing-migration-release-safety","phase":["verification"],"priority":96,"requires":[],"source":"std-testing-release-quality-baseline","sources":["std-testing-release-quality-baseline"],"text":"Verify migration order and target, schema/data result, and relevant compatibility or recovery behavior for persistent-state releases.","type":"verification"},{"activate_all":[],"activate_when":["delivery:production","operation:deployment"],"covers":["availability","compatibility"],"estimated_tokens":26,"excludes":[],"force":"should","id":"testing-release-identity","phase":["verification"],"priority":100,"requires":[],"source":"std-testing-release-quality-baseline","sources":["std-testing-release-quality-baseline"],"text":"Verify the exact source/build identity and target environment for a production release or deployment.","type":"verification"},{"activate_all":[],"activate_when":["risk:credential"],"covers":["credential"],"estimated_tokens":37,"excludes":[],"force":"must-not","id":"token-no-credential-leak","phase":["implementation","verification"],"priority":100,"requires":[],"source":"pat-token-secret-link-handling","sources":["pat-token-secret-link-handling"],"text":"Do not intentionally place credentials in source control, analytics payloads, error messages, normal logs, or unredacted screenshots and evidence.","type":"constraint"},{"activate_all":[],"activate_when":["capability:pwa","delivery:production","operation:integration"],"covers":[],"estimated_tokens":25,"excludes":[],"force":"must","id":"truthful-capability-strength","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"pol-truthful-engineering","sources":["pol-truthful-engineering"],"text":"Describe capabilities only at the strength actually supported by the environment being discussed.","type":"constraint"},{"activate_all":[],"activate_when":["operation:deployment","operation:integration","surface:ci"],"covers":[],"estimated_tokens":27,"excludes":[],"force":"must","id":"truthful-evidence-boundary","phase":["planning","verification"],"priority":95,"requires":[],"source":"pol-truthful-engineering","sources":["pol-truthful-engineering"],"text":"Treat CI results and test doubles only as evidence for the gates and external systems actually exercised.","type":"constraint"},{"activate_all":["capability:persistence","delivery:production"],"activate_when":[],"covers":["data-loss"],"estimated_tokens":28,"excludes":[],"force":"must-not","id":"truthful-no-silent-production-fallback","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"pol-truthful-engineering","sources":["pol-truthful-engineering"],"text":"Production must not silently substitute mock or local persistence merely to make a workflow appear successful.","type":"constraint"},{"activate_all":[],"activate_when":["risk:accessibility","surface:frontend"],"covers":["accessibility"],"estimated_tokens":42,"excludes":[],"force":"must","id":"ui-accessibility-baseline","phase":["implementation","planning","verification"],"priority":100,"requires":[],"source":"std-ui-ux-quality-baseline","sources":["std-ui-ux-quality-baseline"],"text":"Target applicable user-facing web content to WCAG 2.2 AA and preserve keyboard operation, visible focus, meaningful naming/order, reflow, and non-color-only semantics.","type":"constraint"},{"activate_all":[],"activate_when":["surface:frontend"],"covers":["accessibility"],"estimated_tokens":32,"excludes":[],"force":"must","id":"ui-responsive-integrity","phase":["implementation","planning","verification"],"priority":75,"requires":[],"source":"std-ui-ux-quality-baseline","sources":["std-ui-ux-quality-baseline"],"text":"Preserve required information and actions at narrow widths and do not hide real layout defects with global overflow clipping.","type":"constraint"},{"activate_all":[],"activate_when":["archetype:ui-flow-change","archetype:visual-regression-fix","surface:frontend"],"covers":["accessibility"],"estimated_tokens":41,"excludes":[],"force":"should","id":"ui-visual-verification","phase":["verification"],"priority":90,"requires":[],"source":"std-ui-ux-quality-baseline","sources":["std-ui-ux-quality-baseline"],"text":"Render and inspect materially visual changes at risk-relevant states and viewports, and report browser, device, accessibility, or visual gates that were not run.","type":"verification"},{"activate_all":[],"activate_when":["intent:modify","intent:release","operation:deployment"],"covers":["availability"],"estimated_tokens":25,"excludes":[],"force":"must-not","id":"verification-evidence-before-claims","phase":["verification"],"priority":100,"requires":[],"source":"pol-verification-definition-of-done","sources":["pol-verification-definition-of-done"],"text":"Do not claim a gate passed unless it was executed and its result observed for the relevant change.","type":"constraint"},{"activate_all":[],"activate_when":["intent:modify","intent:release"],"covers":["availability","compatibility"],"estimated_tokens":35,"excludes":[],"id":"verification-map-risk-to-cheapest-evidence","phase":["planning","verification"],"priority":72,"requires":[],"source":"pat-risk-based-verification-matrix","sources":["pat-risk-based-verification-matrix"],"text":"Map each material risk or invariant to its failure mode, cheapest reliable evidence, required environment, and explicit acceptance status.","type":"pattern"},{"activate_all":[],"activate_when":["capability:pwa","operation:deployment","operation:integration"],"covers":["availability"],"estimated_tokens":27,"excludes":[],"id":"verification-no-unit-proof-for-remote","phase":["verification"],"priority":86,"requires":[],"source":"pat-risk-based-verification-matrix","sources":["pat-risk-based-verification-matrix"],"text":"Do not use unit tests as evidence that a remote integration, deployment, or physical-device behavior works.","type":"anti-pattern"},{"activate_all":[],"activate_when":["intent:modify","intent:release"],"covers":["availability"],"estimated_tokens":29,"excludes":[],"force":"must","id":"verification-unrun-status","phase":["verification"],"priority":90,"requires":[],"source":"pol-verification-definition-of-done","sources":["pol-verification-definition-of-done"],"text":"Record applicable checks as passed, failed, not run with a reason, or not applicable rather than assuming success.","type":"verification"},{"activate_all":[],"activate_when":["archetype:ui-flow-change","archetype:visual-regression-fix","surface:frontend"],"covers":["compatibility"],"estimated_tokens":36,"excludes":[],"force":"must","id":"visual-evidence-assert-state-first","phase":["implementation","verification"],"priority":90,"requires":[],"source":"pat-visual-evidence-integrity","sources":["pat-visual-evidence-integrity"],"text":"Assert the intended semantic UI state before capturing visual evidence; filenames or action attempts are not proof that the state was reached.","type":"constraint"},{"activate_all":[],"activate_when":["archetype:ui-flow-change","archetype:visual-regression-fix","surface:frontend"],"covers":["compatibility"],"estimated_tokens":54,"excludes":[],"id":"visual-evidence-bind-provenance","phase":["verification"],"priority":88,"requires":[],"source":"pat-visual-evidence-integrity","sources":["pat-visual-evidence-integrity"],"text":"Bind retained visual evidence to the tested build, route, semantic state, viewport/project/theme, and artifact identity strongly enough to prevent stale, overwritten, or mislabeled captures from proving acceptance.","type":"verification"},{"activate_all":[],"activate_when":["capability:pwa","surface:frontend"],"covers":["accessibility","compatibility"],"estimated_tokens":44,"excludes":[],"force":"must-not","id":"visual-evidence-native-boundary","phase":["verification"],"priority":94,"requires":[],"source":"pat-visual-evidence-integrity","sources":["pat-visual-evidence-integrity"],"text":"Do not report browser automation as proof of native launcher, virtual-keyboard, physical-camera, installed-PWA, or assistive-technology behavior that was not actually tested.","type":"constraint"}]}
