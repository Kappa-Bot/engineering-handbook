{
  "schema": "discovery-rules/v1",
  "rules": [
    {"id":"intent-review","when":{"text":"(?:^|;\\s*)(?:please\\s+)?(?:review|revis\\w*|audit\\w*|inspect\\w*|check|comprueba|verifica|consulta|lee|read|diagnos\\w*|diagnost\\w*|measure|mide|medir|benchmark|escane\\w*|scan|(?:realiza|haz|hacer|lleva a cabo|carry out|conduct)\\s+(?:(?:una?|the|an?|a)\\s+)?(?:(?:global|integral|holistic|overall|full|engineering|quality|completa|completo)\\s+){0,4}(?:revision|auditoria|review|audit)|(?:security|seguridad|privacy|privacidad|performance|rendimiento|accessibility|accesibilidad|ux|ui)\\s+(?:audit|auditoria|review|revision|assessment))\\b"},"emit":["intent:review"]},
    {"id":"intent-review-quality-header","scope":"quality-clause","when":{"text":"^quality-review\\b"},"emit":["intent:review"]},
    {"id":"intent-explain","when":{"text":"(?:^|;\\s*)[¿?]?\\s*(?:explain|explica\\w*|describe|research|investiga\\w*|how|como)\\b"},"emit":["intent:explain"]},
    {"id":"intent-plan","when":{"text":"(?:^|;\\s*)(?:plan\\w*|disena un plan|brainstorm\\w*|propone|propon|evaluate|evalua\\w*)\\b"},"emit":["intent:plan"]},
    {"id":"intent-modify","scope":"clause","when":{"all":[{"text":"^(?:(?:please|por favor|necesito que|quiero que|you should)\\s+)?(?:fix|correct|corrig\\w*|repair|repara\\w*|implement\\w*|crea\\w*|build|add|anad\\w*|actualiz\\w*|update|modify|modifica\\w*|cambia\\w*|change|migr\\w*|despl\\w*|deploy(?:s|ed|ing)?|release|install|instala\\w*|configure|configura\\w*|remove|elimina\\w*|delete|borra\\w*|redisen\\w*|redesign|disen\\w*|design|optimiza\\w*|optimize|rotate|rota|reduce|tune|persist|apply|aplica\\w*|polish|pule|refine|haz|monta\\w*|desarrolla\\w*|complete|completa\\w*|termina\\w*|refactor\\w*|renam\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*|clean(?:\\s+up)?|limpi\\w*|escrib\\w*|write|replace|sustitu\\w*)\\b"},{"none":[{"text":"^(?:haz|hacer|realiza\\w*|complete|completa\\w*|termina\\w*)\\s+(?:(?:una?|el|la|an?|the)\\s+)?(?:(?:security|seguridad|privacy|privacidad|performance|rendimiento|accessibility|accesibilidad|reliability|fiabilidad|quality|calidad|global|integral|ux|ui)\\s+){0,5}(?:auditoria|revision|review|audit|analisis|analysis|assessment|evaluacion)\\b"}]}]},"emit":["intent:modify"]},
    {"id":"holistic-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:global|integral|holistic|overall|full|completa|completo|transversal|end.to.end|everything|todo|toda|exhaustiv\\w*|comprehensive)\\b|\\b(?:quality|calidad)\\s+(?:of|de|del|de la)\\s+(?:(?:the|el|la|our)\\s+)?(?:product|producto|app|application|aplicacion|system|sistema|repo|repository|repositorio)\\b"}]},"emit":["archetype:quality-audit","risk:quality-coverage"]},
    {"id":"ui-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:ux|ui|usability|usabilidad|experiencia de usuario|user experience|interfaz|interface|dashboard|pantallas?|screens?|visual quality|calidad visual|responsive|mobile layout|jerarquia visual)\\b"}]},"emit":["archetype:ui-quality-review","risk:ux-quality","surface:frontend"]},
    {"id":"accessibility-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:accessibility|accesibilidad|a11y|wcag|screen reader|lector de pantalla|teclado|keyboard|focus|foco|contraste|contrast|zoom|reflow|target size)\\b"}]},"emit":["archetype:accessibility-review","surface:frontend","risk:accessibility"]},
    {"id":"performance-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:performance|rendimiento|latencia|latency|lcp|inp|cls|core web vitals|speed|carga|page load|slow|lentitud|tiempo de respuesta|query latency|consultas sql|sql query|hydration|hidratacion|long tasks|frame pacing|jank|cuellos de botella|bottleneck|throughput|velocidad)\\b"}]},"emit":["archetype:performance-review","risk:performance"]},
    {"id":"security-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"any":[{"text":"\\b(?:security|seguridad|appsec|vulnerabilit\\w*|vulnerab\\w*|xss|csrf|ssrf|cors|csp|injection|inyeccion|owasp|attack surface|superficie de ataque|hardening|threat model|amenazas)\\b"},{"any":[{"text":"\\b(?:apis?|endpoints?|public route|ruta publica|login|inicio de sesion|gateways?|waf)\\s+(?:(?:request|traffic)\\s+)?(?:(?<!frame[ -])rate[ -]limit(?:s|ing)?|limit(?:e|es|acion) de (?:solicitudes|peticiones))\\b"},{"text":"\\b(?:(?<!frame[ -])rate[ -]limit(?:s|ing)?|limit(?:e|es|acion) de (?:solicitudes|peticiones))\\s+(?:(?:and|y)\\s+backpressure\\s+)?(?:for|at|on|of|in|de|del|en|para)\\s+(?:(?:a|an|the|la|el|un|una|los|las|public|publica|publico|authenticated)\\s+){0,4}(?:apis?|endpoints?|public route|ruta publica|login|inicio de sesion|gateways?|waf)\\b"}]}]}]},"emit":["archetype:security-review","risk:security-exposure"]},
    {"id":"conversion-event-quality-review","scope":"quality-clause","when":{"all":[{"text":"\\b(?:accepted (?:leads?|contacts?|(?:contact )?form submissions?|quote requests?)|(?:contactos?|leads?|envios? de formulario|solicitudes? de presupuesto) aceptad[oa]s?)\\b"},{"any":[{"text":"^quality-review (?:\\w+|carry out|lleva a cabo) (?:(?:a |an |una )?(?:audit|review|auditoria|revision) (?:of |de |del )?)?(?:(?:how|como|that|que|whether|si) )?(?:the |an? |el |la |los |las |una? )?(?:conversion (?:events?|analytics)\\b(?! (?:dashboard(?:['\u2019]s)? )?(?:docs?|documentation|guide|manual|instructions|copy|text|labels?)\\b)|(?:eventos? de conversion|analitica de conversion(?:es)?)\\b(?! de (?:moneda|divisas?|unidades?)\\b))"},{"text":"^quality-review (?:\\w+|carry out|lleva a cabo) (?:(?:a |an |una )?(?:audit|review|auditoria|revision) (?:of |de |del )?)?(?:(?:how|como|that|que|whether|si) )?(?:the |an? |el |la |los |las |una? )?\\b(?:accepted (?:leads?|contacts?|(?:contact )?form submissions?|quote requests?)|(?:contactos?|leads?|envios? de formulario|solicitudes? de presupuesto) aceptad[oa]s?)\\b (?:(?:are |is )?(?:counted|recorded|tracked)|appear|show up|se (?:cuentan|registran)|aparecen|figuran) (?:in|en) (?:the |el |la )?(?:conversion (?:events?|analytics)\\b(?! (?:dashboard(?:['\u2019]s)? )?(?:docs?|documentation|guide|manual|instructions|copy|text|labels?)\\b)|(?:eventos? de conversion|analitica de conversion(?:es)?)\\b(?! de (?:moneda|divisas?|unidades?)\\b))"}]}]},"emit":["archetype:conversion-measurement","risk:measurement-integrity","risk:marketing-privacy"]},
    {"id":"privacy-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:privacy|privacidad|gdpr|rgpd|lopd|cookies?|consent|consentimiento|retention|retencion|data deletion|eliminacion de datos|data minimization|minimizacion de datos|personal data|datos personales|pii|data processing|tratamiento de datos|(?:(?:delete|erase) my account|(?:eliminar|borrar) mi cuenta|(?<!service[ -])users? (?:can |to )?(?:delete|erase) their (?:own )?accounts?|usuarios? (?:pueden? )?(?:eliminar|borrar) sus? (?:propias? )?cuentas?)(?!['’]s\\b)(?=$|[^\\w\\s-]|\\s+(?:in|on|from|through|via|with|without|after|and|or|if|when|flow|workflow|button|en|de|desde|con|sin|si|y|o)\\b)|self[- ]service account[ -](?:deletion|erasure) (?:flow|workflow)(?! for (?:ci |automation )?(?:service|machine|bot)[ -])|(?<!service[ -])user(?:['’]s)? account (?:deletion|erasure) requests?|solicitud(?:es)? de (?:eliminacion|supresion) de la cuenta del usuario|data export|derechos de los interesados)\\b"}]},"emit":["archetype:privacy-review","risk:privacy-exposure"]},
    {"id":"signed-in-member-erasure-review","scope":"quality-clause","when":{"text":"^quality-review\\s+(?:(?:please|por favor)\\s+)?\\w+\\s+(?:(?:whether|if|that|si|que)\\s+)?(?:(?:the|an?|los|las|el|la|una?)\\s+)?(?:signed[- ]in (?:members?|customers?) (?:can |to )?(?:delete|erase) their (?:own )?accounts?|(?:miembros?|clientes?) autenticad[oa]s? (?:pueden? )?(?:eliminar|borrar) sus? (?:propias? )?cuentas?)(?!['\u2019]s\\b)(?=$|[^\\w\\s-]|\\s+(?:in|on|from|through|via|with|without|after|and|or|if|when|using|usando|mediante|en|de(?!\\s+servicios?\\b)|desde|con|sin|si|y|o)\\b)"},"emit":["archetype:privacy-review","risk:privacy-exposure"]},
    {"id":"public-privacy-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:privacy|privacidad|gdpr|rgpd|cookies?|consent|consentimiento|retention|retencion|personal data|datos personales)\\b"},{"text":"\\b(?:public website|public site|web publica|web corporativa|client website|marketing site|landing|commercial website|business website|sitio web publico|pagina web publica|pagina publica|web de empresa)\\b"}]},"emit":["archetype:public-privacy-review"]},
    {"id":"public-privacy-policy-document-review","scope":"clause","when":{"all":[{"text":"^(?:(?:please|por favor)\\s+)?(?:review|revis\\w*|audit\\w*|audita\\w*|inspect|inspeccion\\w*)\\b"},{"text":"\\b(?:privacy policy|politica de privacidad|cookie policy|politica de cookies)\\b"},{"text":"\\b(?:public website|public site|web publica|web corporativa|client website|marketing site|landing|sitio web publico|pagina web publica|pagina publica|web de empresa)\\b"}]},"emit":["archetype:public-privacy-review"]},
    {"id":"reliability-quality-review","scope":"quality-clause","when":{"all":[{"text":"^quality-(?:review|change)\\b"},{"text":"\\b(?:reliability|fiabilidad|resilience|resiliencia|observability|observabilidad|error rates|errores de runtime|runtime errors|production failures|fallos en produccion|recovery|recuperacion|incident(?:s)?|incidentes?|uptime|slo|monitoring|monitorizacion|alertas|availability|disponibilidad)\\b"}]},"emit":["archetype:reliability-review","risk:availability"]},
    {"id":"security-configuration-path","when":{"path":"^(?!.*(?:^|/)(?:docs?|documentation|examples?|fixtures?|__fixtures__|node_modules|vendor|generated|dist|build|\\.next|coverage)/)(?!.*\\.(?:d|generated|gen)\\.(?:ts|tsx|js|jsx|mjs|cjs|py|go|rs|sql|json)$).*(?:^|/)(?:security|csp|cors|csrf|auth|authz|authorization|rls)(?:/[^/]+)*(?:[-_.][^/]*)?\\.(?:ts|tsx|js|mjs|py|go|rs|sql|json|toml)$"},"emit":["archetype:security-review","risk:security-exposure"]},
    {"id":"privacy-owner-path","when":{"path":"^(?!.*(?:^|/)(?:docs?|documentation|examples?|fixtures?|__fixtures__|node_modules|vendor|generated|dist|build|\\.next|coverage)/)(?!.*\\.(?:d|generated|gen)\\.(?:ts|tsx|js|jsx|mjs|cjs|py|go|rs|sql|json)$).*(?:^|/)(?:privacy|consent|cookies?|retention|deletion|erasure|gdpr)(?:/[^/]+)*(?:[-_.][^/]*)?\\.(?:ts|tsx|js|mjs|py|go|rs|sql)$"},"emit":["archetype:privacy-review","risk:privacy-exposure"]},
