{
  "schema": "discovery-rules/v1",
  "rules": [
    {"id":"intent-review","when":{"text":"(?:^|;\\s*)(?:please\\s+)?(?:review|revis\\w*|audit\\w*|inspect\\w*|check|comprueba|verifica|consulta|lee|read|diagnos\\w*|diagnost\\w*)\\b"},"emit":["intent:review"]},
    {"id":"intent-explain","when":{"text":"(?:^|;\\s*)[¿?]?\\s*(?:explain|explica\\w*|describe|research|investiga\\w*|how|como)\\b"},"emit":["intent:explain"]},
    {"id":"intent-plan","when":{"text":"(?:^|;\\s*)(?:plan\\w*|disena un plan|brainstorm\\w*|propone|propon|evaluate|evalua\\w*)\\b"},"emit":["intent:plan"]},
    {"id":"intent-modify","when":{"text":"(?:^|;\\s*)(?:(?:please|por favor|necesito que|quiero que|you should)\\s+)?(?:fix|correct|corrig\\w*|repair|repara\\w*|implement\\w*|crea\\w*|build|add|anad\\w*|actualiz\\w*|update|modify|modifica\\w*|cambia\\w*|change|migr\\w*|despl\\w*|deploy(?:s|ed|ing)?|release|install|instala\\w*|configure|configura\\w*|remove|elimina\\w*|delete|borra\\w*|redisen\\w*|redesign|disen\\w*|design|optimiza\\w*|optimize|rotate|rota|reduce|tune|persist|apply|aplica\\w*|polish|pule|refine|haz|monta\\w*|desarrolla\\w*|complete|completa\\w*|termina\\w*|refactor\\w*|renam\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*|clean(?:\\s+up)?|limpi\\w*|escrib\\w*|write|replace|sustitu\\w*)\\b"},"emit":["intent:modify"]},
    {"id":"code-artifact-task","scope":"clause","when":{"all":[{"text":"\\b(?:code|codigo|source|fuente|python|typescript|javascript|module|modulo|modules|modulos|function|funcion|funciones|variable|variables|api handler|backend|server|servidor|src|software|parser|parsing)\\b"},{"text":"^(?:(?:please|por favor|necesito que|quiero que)\\s+)?(?:implement\\w*|escrib\\w*|write|repair|repara\\w*|fix|corrig\\w*|correct|refactor\\w*|rename\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*|clean(?:\\s+up)?|limpi\\w*|review|revis\\w*|audit\\w*|inspect|build|crea\\w*|add|anad\\w*|modify|modifica\\w*|change|cambia\\w*|update|actualiz\\w*)\\b"},{"none":[{"text":"^(?:document\\w*|documenta\\w*|explain|explica\\w*|read|lee|research|investiga\\w*)\\b"},{"text":"^(?:review|revisa\\w*|audit\\w*|inspect|refactor\\w*|renam\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*|update|actualiz\\w*|fix|corrig\\w*)\\s+(?:(?:the|el|la|los|las)\\s+)?(?:readme|handbook|docs|documentation|documentacion|css class)\\b"},{"text":"\\b(?:in|en|del|of|from|de)\\s+(?:(?:the|el|la)\\s+)?(?:readme|handbook|docs|documentation|documentacion)\\b"},{"text":"^(?:review|revisa\\w*|audit\\w*|inspect)\\s+(?:(?:the|la|el)\\s+)?(?:python|typescript|javascript|code)\\s+(?:docs|documentation|documentacion|readme)\\b"}]}]},"emit":["archetype:code-change"]},
    {"id":"code-organization-task","scope":"clause","when":{"all":[{"text":"^(?:refactor\\w*|renam\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*|clean(?:\\s+up)?|limpi\\w*|remove\\s+dead\\s+code|elimina\\s+codigo\\s+muerto)\\b"},{"text":"\\b(?:code|codigo|source|fuente|src|module|modulo|modules|modulos|function|funcion|variable|variables|helpers?|api handler|backend|server|servidor|repo|repository|repositorio|proyecto|project|python|typescript|javascript)\\b"},{"none":[{"text":"^(?:refactor\\w*|renam\\w*|renombr\\w*|reorgan\\w*|restructur\\w*|reestructur\\w*)\\s+(?:(?:the|el|la|los|las)\\s+)?(?:readme|handbook|docs|documentation|documentacion|css class)\\b"},{"text":"\\b(?:in|en|del|of|from|de)\\s+(?:(?:the|el|la)\\s+)?(?:readme|handbook|docs|documentation|documentacion)\\b"},{"text":"^(?:reorgan\\w*|restructur\\w*|reestructur\\w*|clean(?:\\s+up)?|limpi\\w*)\\b.*\\b(?:photos?|fotos|downloads|descargas|marketing copy)\\b"}]}]},"emit":["archetype:code-change","archetype:code-organization"]},
    {"id":"code-structural-edit","scope":"clause","when":{"all":[{"text":"^(?:simplif\\w*|split|extract)\\b"},{"text":"\\b(?:code|codigo|source|fuente|src|module|modulo|modules|modulos|function|funcion|variable|variables|helpers?|backend|server|servidor|api)\\b"},{"none":[{"text":"\\b(?:readme|handbook|docs|documentation|documentacion)\\b"}]}]},"emit":["intent:modify","archetype:code-change","archetype:code-organization"]},
    {"id":"code-api-edit","scope":"clause","when":{"text":"^(?:fix|correct|corrig\\w*|repair|repara\\w*|implement\\w*|review|revisa\\w*)\\s+(?:(?:the|el|la|an|una)\\s+)?api\\b(?!\\s+(?:docs|documentation|documentacion|readme|handbook)\\b)"},"emit":["archetype:code-change"]},
    {"id":"code-path","when":{"path":"^(?!.*(?:^|/)(?:docs?|documentation|examples?|fixtures?|__fixtures__|node_modules|vendor|generated|dist|build|\\.next|coverage)/)(?!.*\\.(?:d|generated)\\.ts$).+\\.(?:py|ts|tsx|js|jsx|mjs|cjs|go|rs|rb|java|kt|swift|c|cc|cpp|cs|php|vue|svelte|css|scss|html|sql)$"},"emit":["archetype:code-change"]},
    {"id":"dependency-choice-text","scope":"clause","when":{"all":[{"text":"\\b(?:dependency|dependencies|dependencias?|librerias?|libraries|library|packages?|paquetes?|npm package|pip package)\\b"},{"text":"\\b(?:choose|select|pick|evaluate|evalua\\w*|elige|elegir|escoge|compar\\w*|replace|sustitu\\w*|upgrade|actualiz\\w*|install|instala\\w*|add|anad\\w*|decide|decision|revis\\w*|review)\\b"},{"none":[{"text":"^(?:document\\w*|documenta\\w*|explain|explica\\w*|read|lee)\\b.*\\b(?:handbook|readme|docs|documentation|documentacion)\\b"},{"text":"^(?:review|revisa\\w*|audit\\w*|inspect|update|actualiza\\w*)\\b.{0,75}\\b(?:documentation|documentacion|docs|readme|handbook)\\b"}]}]},"emit":["archetype:dependency-selection"]},
    {"id":"dependency-manifest-path","when":{"path":"^(?!.*(?:^|/)(?:node_modules|vendor|dist|build|docs?|documentation|examples?|fixtures?|__fixtures__|generated|coverage|\\.next)/)(?:.+/)?(?:package\\.json|(?:package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock)|pyproject\\.toml|requirements[^/]*\\.txt|poetry\\.lock|uv\\.lock|cargo\\.toml|cargo\\.lock|go\\.mod|go\\.sum|gemfile(?:\\.lock)?|pom\\.xml|build\\.gradle(?:\\.kts)?)$"},"emit":["archetype:dependency-selection"]},
    {"id":"schema-change","when":{"text":"\\b(?:migrat(?:e|es|ion|ions|ing)|migra(?:r|cion|ciones|mos)?|migres|schema(?!\\.org| markup)|esquema|column(?:a|as|s)?|archived_at)\\b"},"emit":["operation:migration","capability:persistence","surface:database","state:migration","state:durable-change","archetype:schema-change","risk:data-loss","risk:compatibility"]},
    {"id":"migration-path","when":{"path":"(?:^|/)(?:migrations?/[^/]+(?:/[^/]+)*|schema\\.(?:sql|prisma))$"},"emit":["operation:migration","capability:persistence","surface:database","state:migration","state:durable-change","archetype:schema-change","risk:data-loss","risk:compatibility"]},
    {"id":"database-surface","when":{"any":[{"text":"\\b(?:database|base de datos|sql|postgres(?:ql)?|consultas?)\\b"},{"path":"\\.sql$"}]},"emit":["surface:database","capability:persistence"]},
    {"id":"backend-surface","when":{"text":"\\b(?:backend|server|servidor|mutation|mutacion)\\b"},"emit":["surface:backend"]},
    {"id":"mutation-operation","when":{"text":"(?:^|;\\s*)(?:create|update|archive|delete|crea\\w*|actualiza\\w*|archiva\\w*|borra\\w*|elimina\\w*)\\b|\\b(?:mutation|mutacion)\\b"},"emit":["operation:mutation"]},
    {"id":"authorization-text","when":{"text":"\\b(?:authenticated|authorization|authorisation|authz|permissions?|roles?|autenticad[oa]s?|permisos?|rol|autorizacion|tenant(?:s|id)?|multi[- ]?tenan\\w*|multiempresa|multi-empresa|otra empresa|otra organizacion|cross-tenant)\\b"},"emit":["operation:authorization","capability:auth","risk:authorization","boundary:privileged"]},
    {"id":"tenant-isolation","when":{"text":"\\b(?:tenant(?:s|id)?|multi[- ]?tenan\\w*|multiempresa|multi-empresa|otra empresa|otra organizacion|cross-tenant)\\b"},"emit":["risk:tenant-isolation"]},
    {"id":"authorization-path","when":{"path":"(?:^|/)(?:[^/]*[-_.])?(?:permissions?|authz|rls|policies)(?:[-_.][^/]*)?(?:/[^/]+)*\\.(?:ts|tsx|js|py|go|rs|sql|rb)$"},"emit":["operation:authorization","capability:auth","risk:authorization","boundary:privileged"]},
    {"id":"integration-boundary","when":{"all":[{"text":"\\b(?:integration|integracion|webhooks?|api|external provider|proveedor externo)\\b"},{"none":[{"text":"^(?:read|lee|explain|explica|documenta|describe)\\b.*\\b(?:docs|documentation|documentacion|readme)\\b"}]}]},"emit":["operation:integration","boundary:external","archetype:external-integration","risk:availability","risk:compatibility"]},
    {"id":"production-release","when":{"text":"(?:^|;\\s*)(?:please\\s+)?(?:deploy(?:s|ed|ing)?|despliega|desplegar|release|publica la version)\\b"},"emit":["operation:deployment","delivery:production","archetype:production-release","risk:availability","risk:compatibility"]},
    {"id":"production-observation","when":{"all":[{"text":"\\b(?:production|produccion)\\b"},{"none":[{"text":"(?:^|;\\s*)(?:please\\s+)?(?:deploy(?:s|ed|ing)?|despliega|desplegar|release|publica la version)\\b"}]}]},"emit":["archetype:production-observation","risk:availability"]},
    {"id":"credential-text","when":{"text":"\\b(?:secret(?:s|os?)?|credential(?:s)?|credenciales?|contrasenas?|passwords?|bearer|refresh token|access token|auth token|api token|api key|token de acceso|token de autenticacion|rotate.{0,20}tokens?)\\b"},"emit":["risk:credential"]},
    {"id":"credential-path","when":{"path":"(?:^|/)(?:[^/]*[-_.])?(?:secrets?|credentials?|passwords?|auth[-_]token|access[-_]token)(?:[-_.][^/]*)?(?:/[^/]+)*\\.(?:ts|tsx|js|py|go|rs|sql|rb)$"},"emit":["risk:credential"]},
    {"id":"invitation-auth","when":{"text":"\\b(?:invitations?|invite|invitacion(?:es)?|invitar)\\b"},"emit":["operation:mutation","capability:auth","risk:authorization","risk:tenant-isolation","archetype:authenticated-mutation"]},
    {"id":"pwa-capability","when":{"any":[{"text":"\\b(?:pwa|service worker)\\b"},{"path":"(?:^|/)(?:manifest\\.webmanifest|service-worker[^/]*|sw\\.js)$"}]},"emit":["capability:pwa","archetype:pwa-capability-change","surface:frontend"]},
    {"id":"background-job","when":{"text":"\\b(?:background job|cron|queue|cola de trabajos|tarea en segundo plano)\\b"},"emit":["archetype:background-job","surface:backend"]},
    {"id":"performance","when":{"text":"\\b(?:performance|latency|latencia|slow|lentitud|lcp|inp|cls|core web vitals|rendimiento|fluidez|fotogramas|frame pacing|jank|optimizar consultas)\\b"},"emit":["risk:performance"]},
    {"id":"accessibility","when":{"any":[{"text":"\\b(?:accessibility|accesibilidad|a11y|keyboard|focus|reflow|wcag)\\b"},{"path":"(?:accessibility|a11y)[^/]*\\.(?:ts|tsx|js|css)$"}]},"emit":["surface:frontend","risk:accessibility"]},
    {"id":"ci-path","when":{"path":"(?:^|/)\\.github/workflows/"},"emit":["surface:ci"]},
    {"id":"custom-agent-path","when":{"path":"(?:^|/)\\.codex/(?:agents/[^/]+\\.toml|hooks\\.json)$"},"emit":["archetype:agent-tooling-change","risk:agent-execution"]}
  ]
}
