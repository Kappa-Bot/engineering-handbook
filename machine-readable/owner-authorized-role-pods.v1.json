      "responsibilities": [
        "high-leverage architecture and security decisions",
        "product and UX architecture",
        "information architecture",
        "brand and design-system authority",
        "ambiguous trade-offs",
        "milestone or final independent implementation review when it is the highest-leverage dispatch",
        "difficult diagnosis that cannot be resolved mechanically"
      ],
      "implementation_diff_author": false
    },
    "delivery": {
      "owner_default_model_alias": "Luna 6",
      "owner_default_reasoning": "xhigh",
      "responsibilities": [
        "implementation of frozen authority",
        "test-driven development",
        "systematic debugging with settled intended behavior",
        "mechanical refactors and migrations",
        "focused commits",
        "documentation synchronization",
        "resolution of unambiguous review findings"
      ],
      "implementation_diff_author": true
    }
  },
  "communication": {
    "repository_over_conversation": true,
    "direct_subagent_to_subagent": false,
    "target_parent_dispatches_per_role_per_megaplan": 1,
