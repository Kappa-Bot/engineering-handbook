  "execution": {
    "exhaustive_mode_requires_owner_authorization": true,
    "continue_until_authorized_feasible_scope_exhausted": true,
    "checkpoints_are_recovery_boundaries_not_stop_points": true,
    "routine_reapproval_required": false,
    "blocked_dependency_does_not_stop_independent_work": true,
    "mandatory_evidence_still_blocks_its_gate": true,
    "unrelated_scope_expansion_allowed": false,
    "respect_enforced_runtime_context_and_quota_limits": true,
    "forced_interruption_requires_durable_next_action": true,
    "background_or_unlimited_runtime_claims_allowed": false
  },
  "cost_controls": {
